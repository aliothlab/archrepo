[Unit]
Description=sing-box service
Documentation=https://sing-box.sagernet.org
After=network.target network-online.target nss-lookup.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
User=sing-box
Group=sing-box
ExecStart=/usr/bin/sing-box -D /var/lib/sing-box -C /etc/sing-box run
ExecReload=/usr/bin/kill -HUP $MAINPID
KillSignal=SIGTERM
TimeoutStopSec=15

# ── 能力(tproxy:CAP_NET_RAW 设 IP_TRANSPARENT;CAP_NET_BIND_SERVICE 绑<1024回包端口)──
NoNewPrivileges=true
CapabilityBoundingSet=
CapabilityBoundingSet=CAP_NET_RAW CAP_NET_BIND_SERVICE
AmbientCapabilities=
AmbientCapabilities=CAP_NET_RAW CAP_NET_BIND_SERVICE
# ── 文件系统 ──
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectProc=invisible
ProcSubset=pid
StateDirectory=sing-box
StateDirectoryMode=0700
WorkingDirectory=/var/lib/sing-box
ReadWritePaths=/var/lib/sing-box
UMask=0077
# ── 设备 ──
PrivateDevices=true
DevicePolicy=closed
DeviceAllow=
# ── 内核 / 系统防护 ──
ProtectClock=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectControlGroups=true
ProtectHostname=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictNamespaces=true
RemoveIPC=true
# ── 网络地址族(AF_NETLINK 供接口监听/进程规则;不用 AF_UNIX)──
RestrictAddressFamilies=AF_INET AF_INET6 AF_NETLINK
# ── 系统调用过滤 ──
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@resources @privileged @obsolete @keyring @memlock @setuid
# ── 资源 / 重启 ──
LimitNOFILE=1048576
TasksMax=1024
MemoryHigh=384M
MemoryMax=512M
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
