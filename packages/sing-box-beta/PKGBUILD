pkgname=sing-box-beta
_pkgname=sing-box
pkgver=1.14.0beta.13
_pkgver=$(echo "${pkgver}" | sed 's/\([0-9]\+\.[0-9]\+.[0-9]\+\)\(alpha\|beta\|rc\)/\1-\2/')
pkgrel=1
pkgdesc='The universal proxy platform (minimal build: tproxy + hysteria2/tuic)'
arch=('x86_64')
url='https://sing-box.sagernet.org/'
license=('custom:GPL-3.0-or-later WITH name use or association addition')
makedepends=('go')
options=('!lto' '!debug' '!strip')
source=(
    "${_pkgname}-${_pkgver}.tar.gz::https://github.com/SagerNet/sing-box/archive/v${_pkgver}.tar.gz"
    "${_pkgname}.service"
    "${_pkgname}.tmpfiles"
)
sha256sums=('0cb121b9a8326aaf86f360a681a1f8f4ba3ed2f347c3a16617a1ec1e598b48ff'
            '66c76234587818796426034a69aae90dac9d70e5095a293ebf1d36a6ccb051e5'
            '8b4a8077e01f7eb16b5de451aba24fb0163f5ec5fe507bb6a717d645cab80b98')
provides=("${_pkgname}")
conflicts=("${_pkgname}")

build() {
    cd "${_pkgname}-${_pkgver}"

    export CGO_ENABLED=0
    export GOTOOLCHAIN=local
    export GOPATH="${srcdir}/gopath"
    export GOFLAGS="-trimpath -mod=readonly -modcacherw -buildvcs=false"

    local _tags='with_quic'
    local _ldflags_shared="$(cat release/LDFLAGS)"

    go build -v \
        -buildmode=pie \
        -tags "${_tags}" \
        -ldflags "-X github.com/sagernet/sing-box/constant.Version=${_pkgver} ${_ldflags_shared} -s -w -buildid=" \
        ./cmd/sing-box
}

package() {
    cd "${_pkgname}-${_pkgver}"

    install -Dm644 LICENSE -t "${pkgdir}/usr/share/licenses/${pkgname}"
    install -Dm755 "${_pkgname}" -t "${pkgdir}/usr/bin"

    install -dm750 "${pkgdir}/etc/${_pkgname}"

    install -Dm644 release/config/"${_pkgname}".sysusers "${pkgdir}/usr/lib/sysusers.d/${_pkgname}.conf"
    install -Dm644 "${srcdir}/${_pkgname}.tmpfiles" "${pkgdir}/usr/lib/tmpfiles.d/${_pkgname}.conf"
    install -Dm644 "${srcdir}/${_pkgname}.service" "${pkgdir}/usr/lib/systemd/system/${_pkgname}.service"

    install -Dm644 release/completions/"${_pkgname}".bash \
        "${pkgdir}/usr/share/bash-completion/completions/${_pkgname}"
    install -Dm644 release/completions/"${_pkgname}".fish \
        "${pkgdir}/usr/share/fish/vendor_completions.d/${_pkgname}.fish"
    install -Dm644 release/completions/"${_pkgname}".zsh \
        "${pkgdir}/usr/share/zsh/site-functions/_${_pkgname}"
}
