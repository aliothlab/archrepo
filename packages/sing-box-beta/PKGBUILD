pkgname=sing-box-beta
_pkgname=sing-box
pkgver=1.14.0
_pkgver=$(echo "${pkgver}" | sed 's/\([0-9]\+\.[0-9]\+.[0-9]\+\)\(alpha\|beta\|rc\)/\1-\2/')
pkgrel=3
pkgdesc='The universal proxy platform'
arch=('x86_64')
url='https://sing-box.sagernet.org/'
license=('GPL-3.0-or-later')
makedepends=('go')
options=('!debug')
source=(
    "${_pkgname}-${_pkgver}.tar.gz::https://github.com/SagerNet/sing-box/archive/v${_pkgver}.tar.gz"
    "${_pkgname}.service"
    "${_pkgname}.tmpfiles"
)
sha256sums=('87baf6852e37941cbe40bdd94bec81c957c88a56751cecd6bbf0e6108bc69398'
            'badc614e9b6918a977277529a7ef888af8c1c4b753c106ee4e7e289babadbea2'
            '8b4a8077e01f7eb16b5de451aba24fb0163f5ec5fe507bb6a717d645cab80b98')
provides=("${_pkgname}")
conflicts=("${_pkgname}")

prepare() {
    export GOPATH="${srcdir}"
    cd "${srcdir}/${_pkgname}-${pkgver}"
    go mod download -modcacherw
}

build() {
    cd "${_pkgname}-${_pkgver}"

    export CGO_ENABLED=0
    export GOTOOLCHAIN=local
    export GOPATH="${srcdir}"
    export GOFLAGS="-buildmode=pie -trimpath -mod=readonly -modcacherw"

    # http2legacy keeps x/net/http2 (*Transport).connPool, linknamed by force_close.go; drop when upstream stops.
    local _tags='with_quic,http2legacy,with_tailscale,with_wireguard,with_gvisor'
    # tlsunsafeekm is gone in Go 1.27 (startup abort), tlssha1 is dead weight on TLS 1.3.
    local _ldflags_shared="$(sed -E 's/,?(tlsunsafeekm|tlssha1)=[^, ]+//g' release/LDFLAGS)"

    go build -v \
        -tags "${_tags}" \
        -ldflags "-X github.com/sagernet/sing-box/constant.Version=${_pkgver} ${_ldflags_shared}" \
        ./cmd/sing-box
}

package() {
    cd "${_pkgname}-${_pkgver}"

    install -Dm644 LICENSE -t "${pkgdir}/usr/share/licenses/${pkgname}"
    install -Dm755 "${_pkgname}" -t "${pkgdir}/usr/bin"

    install -dm750 "${pkgdir}/etc/${_pkgname}"

    install -Dm644 release/config/"${_pkgname}".sysusers "${pkgdir}/usr/lib/sysusers.d/${_pkgname}.conf"
    install -Dm644 "${srcdir}/${_pkgname}.tmpfiles" "${pkgdir}/usr/lib/tmpfiles.d/${_pkgname}.conf"
    install -Dm644 "${srcdir}/${_pkgname}.service" "${pkgdir}/usr/lib/systemd/system/${_pkgname}.service"

    install -Dm644 release/completions/"${_pkgname}".bash \
        "${pkgdir}/usr/share/bash-completion/completions/${_pkgname}"
    install -Dm644 release/completions/"${_pkgname}".fish \
        "${pkgdir}/usr/share/fish/vendor_completions.d/${_pkgname}.fish"
    install -Dm644 release/completions/"${_pkgname}".zsh \
        "${pkgdir}/usr/share/zsh/site-functions/_${_pkgname}"
}
