
_repo=meshlab

# Extracted into src/external/downloads/ by prepare(). MeshLab would otherwise
# file(DOWNLOAD) each of them while configuring.
_externals=(
  StructureSynth-1.5.1 # filter_ssynth
  levmar-2.6.1         # filter_isoparametrization, filter_mutual{info,global}, edit_mutualcorrs
  lib3ds-1.3.0         # io_3ds
  libE57Format-3.1.1   # io_e57
  libigl-2.6.0         # filter_{parametrization,cubization,mesh_booleans,mesh_alpha_wrap}
  nexus-2025.05        # filter_io_nxs, needs corto below
  OpenCTM-1.0.3        # io_ctm
  tinygltf-2.6.3       # io_gltf
)

pkgname=meshlab-git
pkgver=2025.07.r29.g71e7b0b
pkgrel=1
pkgdesc='System for processing and editing 3D triangular meshes (git version)'
arch=('x86_64')
url='https://www.meshlab.net'
license=(
  'BSD-2-Clause'                  # EasyExif
  'BSD-3-Clause'                  # PoissonRecon, CRC++
  'BSL-1.0'                       # libE57Format
  'CC0-1.0'                       # Hedley, inside tinygltf's json.hpp
  'GPL-2.0-or-later'              # MeshLab, VCGlib, levmar, nexus, render_radiance_scaling
  'GPL-3.0-or-later'              # filter_texture_defragmentation
  'LGPL-2.1-only OR GPL-3.0-only' # StructureSynth
  'LGPL-2.1-or-later'             # lib3ds
  'LGPL-3.0-or-later'             # corto headers, contradicting its MIT LICENSE.txt
  'MIT'                           # tinygltf, nlohmann/json, corto, newuoa
  'MPL-2.0'                       # libigl, CubicStylization
  'Unlicense'                     # miniz, inside filter_sketchfab
  'Zlib'                          # OpenCTM
)
depends=(
  'embree'     # filter_embree
  'glew'
  'glibc'
  'glu'        # OpenGL::GLU, used by ~10 plugins
  'gmp'        # linked in through CGAL::CGAL
  'hicolor-icon-theme'
  'libgcc'
  'libglvnd'
  'libgomp'    # OpenMP
  'libstdc++'
  'mpfr'       # linked in through CGAL::CGAL
  'muparser'   # filter_func
  'qhull'      # filter_qhull
  'qt5-base'   # master still has no Qt6 build path
  'xerces-c'   # libE57Format
)
makedepends=(
  'boost'      # headers
  'boost-libs' # Boost::thread is on the link line, --as-needed drops it
  'cgal'       # header-only
  'cmake'
  'git'
  'ninja'
)
provides=("meshlab=$pkgver")
conflicts=('meshlab')
options=('!debug')
source=("$_repo::git+https://github.com/cnr-isti-vclab/meshlab.git"
        'vcglib::git+https://github.com/cnr-isti-vclab/vcglib.git'
        'https://www.meshlab.net/data/libs/StructureSynth-1.5.1.zip'
        'https://www.meshlab.net/data/libs/corto-2025.07.zip'
        'https://www.meshlab.net/data/libs/levmar-2.6.1.zip'
        'https://www.meshlab.net/data/libs/lib3ds-1.3.0.zip'
        'https://www.meshlab.net/data/libs/libE57Format-3.1.1.zip'
        'libigl-2.6.0.zip::https://github.com/libigl/libigl/archive/refs/tags/v2.6.0.zip'
        'https://www.meshlab.net/data/libs/nexus-2025.05.zip'
        'https://www.meshlab.net/data/libs/OpenCTM-1.0.3-src.zip'
        'https://www.meshlab.net/data/libs/tinygltf-2.6.3.zip')
sha256sums=('SKIP'
            'SKIP'
            'a53597c737f4562717abc87e00d68463da220c8317eb716b323fe7b9f02b9e36'
            '35f2cd92fa210f5754e54a3b89dc23c104d060ab250930e1b96e7e74a71a7fe4'
            '14d71a0e3be099e50424d8f016481a8ff4e9388b807f31304801fb4b6799da31'
            'f5b00c302955a67fa5fb1f2d3f2583767cdc61fdbc6fd843c0c7c9d95c5629e3'
            '215001515d0aa44d7f2beb894fbaded2679a9b94e5b8f8dcd148aa86e3225b6b'
            'b7679fc8eba847b64ffa33a112caad1a1cfacc2a0621014d3b6829c08acfe979'
            '595961fbcf5534601b3cab843e476127ff079990b9d1a5dfa2d0cb8f16faefab'
            '1310346651d96dc310022fde23a7d1a7810f32bccdfda4be0ea1b7a3cfd2b583'
            'f977628515d6a754eaaf5549af3843f33a0f674da807441f7bce0d77ca794b2a')

pkgver() {
  git -C "$_repo" describe --long --tags --abbrev=7 | sed 's/^MeshLab-//;s/\([^-]*-g\)/r\1/;s/-/./g'
}

prepare() {
  # Point the vcglib submodule at the local clone so build() never fetches.
  git -C "$_repo" submodule set-url -- src/vcglib "$srcdir/vcglib"
  git -C "$_repo" -c protocol.file.allow=always submodule update --init --force src/vcglib

  local _dl="$_repo/src/external/downloads"
  mkdir -p "$_dl"
  mv "${_externals[@]}" "$_dl"
  rmdir "$_dl/nexus-2025.05/src/corto" # empty submodule placeholder
  mv corto-2025.07 "$_dl/nexus-2025.05/src/corto"

  # Plugins are installed without an RPATH, so io_3ds cannot find
  # libexternal-lib3ds.so in /usr/lib/meshlab. Point them at their parent dir.
  sed -i 's|^\tset(CMAKE_INSTALL_RPATH)$|\tset(CMAKE_INSTALL_RPATH $ORIGIN/..)|' \
    "$_repo/src/CMakeLists.txt"
}

build() {
  # -DNDEBUG: CMAKE_BUILD_TYPE=None does not define it, so assert() would stay live.
  local _opts=(
    -DCMAKE_BUILD_TYPE=None
    -DCMAKE_C_FLAGS="$CFLAGS -DNDEBUG"
    -DCMAKE_CXX_FLAGS="$CXXFLAGS -DNDEBUG"
    -DCMAKE_INSTALL_PREFIX=/usr
    -DCMAKE_INSTALL_LIBDIR=lib
    -GNinja

    ############################## ENABLED ##############################

    -DMESHLAB_BUILD_STRICT=ON                     # -Wl,--no-undefined
    -DMESHLAB_USE_DEFAULT_BUILD_AND_INSTALL_DIRS=ON
    -DMESHLAB_ALLOW_OPTIONAL_EXTERNAL_LIBRARIES=ON
    -DMESHLAB_BUILD_EXTERNAL_SOURCES_WITHOUT_WARNINGS=ON

    # system libraries
    -DMESHLAB_ALLOW_SYSTEM_BOOST=ON               # filter_mesh_{booleans,alpha_wrap}
    -DMESHLAB_ALLOW_SYSTEM_CGAL=ON                # filter_mesh_{booleans,alpha_wrap}
    -DMESHLAB_ALLOW_SYSTEM_EMBREE=ON              # filter_embree
    -DMESHLAB_ALLOW_SYSTEM_GLEW=ON
    -DMESHLAB_ALLOW_SYSTEM_MUPARSER=ON            # filter_func
    -DMESHLAB_ALLOW_SYSTEM_QHULL=ON               # filter_qhull
    -DMESHLAB_ALLOW_SYSTEM_XERCES=ON              # libE57Format

    # shipped inside the MeshLab / VCGlib source tree
    -DMESHLAB_ALLOW_BUNDLED_SOURCE_EASYEXIF=ON
    -DMESHLAB_ALLOW_BUNDLED_NEWUOA=ON

    # pre-extracted by prepare(), so the download branch is never reached
    -DMESHLAB_ALLOW_DOWNLOAD_SOURCE_LEVMAR=ON
    -DMESHLAB_ALLOW_DOWNLOAD_SOURCE_LIB3DS=ON
    -DMESHLAB_ALLOW_DOWNLOAD_SOURCE_LIBE57=ON
    -DMESHLAB_ALLOW_DOWNLOAD_SOURCE_LIBIGL=ON
    -DMESHLAB_ALLOW_DOWNLOAD_SOURCE_NEXUS=ON
    -DMESHLAB_ALLOW_DOWNLOAD_SOURCE_OPENCTM=ON
    -DMESHLAB_ALLOW_DOWNLOAD_SOURCE_STRUCTURE_SYNTH=ON
    -DMESHLAB_ALLOW_DOWNLOAD_SOURCE_TINYGLTF=ON

    ############################## DISABLED #############################

    -DMESHLAB_BUILD_MINI=OFF
    -DMESHLAB_BUILD_ONLY_LIBRARIES=OFF
    -DMESHLAB_BUILD_WITH_DOUBLE_SCALAR=OFF        # float scalars, as upstream ships
    -DMESHLAB_ENABLE_DEBUG_LOG_FILE=OFF
    -DMESHLAB_IS_NIGHTLY_VERSION=OFF              # would run git and rewrite resources/git_sha.txt

    # not packaged by Arch, so use the copies in src/external/downloads
    -DMESHLAB_ALLOW_SYSTEM_LIB3DS=OFF
    -DMESHLAB_ALLOW_SYSTEM_OPENCTM=OFF

    # fetch sources/binaries while configuring
    -DMESHLAB_ALLOW_BUNDLED_SOURCE_GLEW=OFF       # in-tree copy, superseded by system glew
    -DMESHLAB_ALLOW_DOWNLOAD_SOURCE_BOOST=OFF
    -DMESHLAB_ALLOW_DOWNLOAD_SOURCE_CGAL=OFF
    -DMESHLAB_ALLOW_DOWNLOAD_SOURCE_EMBREE=OFF
    -DMESHLAB_ALLOW_DOWNLOAD_DLL_EMBREE=OFF
    -DMESHLAB_ALLOW_DOWNLOAD_SOURCE_MUPARSER=OFF
    -DMESHLAB_ALLOW_DOWNLOAD_SOURCE_QHULL=OFF
    -DMESHLAB_ALLOW_DOWNLOAD_SOURCE_XERCES=OFF

    # skipped plugins
    -DMESHLAB_ALLOW_DOWNLOAD_SOURCE_LIB3MF=OFF    # io_3mf: 55 MB archive, extracts without a top dir
    -DMESHLAB_ALLOW_DOWNLOAD_SOURCE_U3D=OFF       # io_u3d: runtime .so lookup assumes the AppImage layout
  )

  cmake -B build -S "$_repo" "${_opts[@]}" -Wno-author
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build

  # Fully linked into io_e57; !staticlibs keeps it for lack of a sibling .so.
  rm "$pkgdir/usr/lib/meshlab/libE57Format.a"

  # Bundled code linked into the binaries, not covered by licenses/common.
  local _licdir="$pkgdir/usr/share/licenses/$pkgname" _dl="$_repo/src/external/downloads"
  install -Dm644 "$_repo/src/external/easyexif-1.0/LICENSE" "$_licdir/EasyExif.BSD-2-Clause"
  install -Dm644 "$_dl/OpenCTM-1.0.3/LICENSE.txt" "$_licdir/OpenCTM.Zlib"
  install -Dm644 "$_dl/libE57Format-3.1.1/LICENSE.md" "$_licdir/libE57Format.BSL-1.0"
  install -Dm644 "$_dl/libE57Format-3.1.1/extern/CRCpp/LICENSE" "$_licdir/CRCpp.BSD-3-Clause"
  install -Dm644 "$_dl/libigl-2.6.0/LICENSE.MPL2" "$_licdir/libigl.MPL-2.0"
  install -Dm644 "$_dl/nexus-2025.05/src/corto/LICENSE.txt" "$_licdir/corto.MIT"
  install -Dm644 "$_dl/tinygltf-2.6.3/LICENSE" "$_licdir/tinygltf.MIT"
}
