pkgname=auth-thu
_pkgname=GoAuthing
pkgver=2.4.0
pkgrel=1
pkgdesc='Commandline Tunet (auth4/6.tsinghua.edu.cn) authentication tool'
arch=('x86_64')
url='https://github.com/z4yx/GoAuthing'
license=('GPL-3.0-only')
depends=('glibc')
makedepends=('go')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz"
        'goauthing.service'
)
sha256sums=('bd05ebe3849eec1318f4a37e5042538a5c71b1ea3baad92e52a38967fc4fd650'
            '4e6b131dccc8c2b5956b7f00d4c7ed1eaaf8845817d3e7deaabaec6cd7c72895'
)

prepare() {
    cd "$_pkgname-$pkgver"
    mkdir -p build
    sed -i 's|/usr/local/bin/auth-thu|/usr/bin/auth-thu|g' docs/systemd/*/*.service
}

build() {
    cd "$_pkgname-$pkgver"
    export CGO_CPPFLAGS="$CPPFLAGS"
    export CGO_CFLAGS="$CFLAGS"
    export CGO_CXXFLAGS="$CXXFLAGS"
    export CGO_LDFLAGS="$LDFLAGS"
    export GOFLAGS="-buildmode=pie -trimpath -ldflags=-linkmode=external -mod=readonly -modcacherw"
    go build -o "build/$pkgname" ./cli
}

package() {
    cd "$_pkgname-$pkgver"
    install -Dm755 "build/$pkgname" -t "$pkgdir/usr/bin"
    install -Dm644 "$srcdir/goauthing.service" "$pkgdir/usr/lib/systemd/system/goauthing.service"
}
