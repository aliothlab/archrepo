  'GPL-2.0-only'      # qMPlane, qColorimetricSegmenter, qCompass, qPCV, qLASIO
  'GPL-2.0-or-later'  # CloudCompare itself, dxflib, qCSF
  'GPL-3.0-only'      # qVoxFall
  'GPL-3.0-or-later'  # qJSonRPC, QCustomPlot, CGAL
  'LGPL-2.0-or-later' # CCCoreLib, shapelib
  # PoissonRecon vendors Stanford's PLY reader: distribution is granted, selling is not.
  'LicenseRef-Stanford-PLY'
  'MIT'               # CCCoreLib (parts), QDarkStyleSheet, normals_Hough
  'Qhull'             # qHPR
)
