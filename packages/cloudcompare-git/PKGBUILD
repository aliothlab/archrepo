_repo=CloudCompare
_cccorelib=libs/qCC_db/extern/CCCoreLib

# submodule path in the CloudCompare tree :: name of the matching source entry
_submodules=(
  "$_cccorelib::CCCoreLib"
  'libs/CCAppCommon/QDarkStyleSheet::QDarkStyleSheet'
  'plugins/core/IO/MeshIO::MeshIO' # plugin off, but IO/CMakeLists.txt:1 adds it unconditionally
  'plugins/core/IO/qE57IO/extern/libE57Format::libE57Format'
  'plugins/core/Standard/q3DMASC::q3DMASC'
  'plugins/core/Standard/qCanupo/contrib/dlib::dlib'
  'plugins/core/Standard/qColorimetricSegmenter::qColorimetricSegmenter'
  'plugins/core/Standard/qJSonRPCPlugin::qJSonRPCPlugin'
  'plugins/core/Standard/qMPlane::mplane-plugin'
  'plugins/core/Standard/qPoissonRecon/extern/PoissonRecon::PoissonRecon'
  'plugins/core/Standard/qVoxFall::qVoxFall'
)

