  'qt6-svg'        # dlopened qsvg image plugin, no DT_NEEDED
  'qt6-websockets' # qJSonRPC
  'xerces-c'       # vendored libE57Format (qE57IO)
)
makedepends=(
  'cgal'      # header-only
  'cmake'
  'eigen'     # CC_USE_EIGEN, qHoughNormals
  'git'
  'libglvnd'  # find_package(OpenGL REQUIRED) in qPCV
  'ninja'
  'qt6-tools' # Qt6LinguistTools
)
provides=("cloudcompare=$pkgver")
conflicts=('cloudcompare')
options=('!debug')
source=("$_repo::git+https://github.com/CloudCompare/CloudCompare.git"
        'CCCoreLib::git+https://github.com/CloudCompare/CCCoreLib.git'
        'nanoflann::git+https://github.com/jlblancoc/nanoflann.git'
        'QDarkStyleSheet::git+https://github.com/ColinDuquesnoy/QDarkStyleSheet.git'
        'MeshIO::git+https://github.com/CloudCompare/MeshIO.git'
        'libE57Format::git+https://github.com/asmaloney/libE57Format.git'
        'q3DMASC::git+https://github.com/dgirardeau/q3DMASC.git'
        'dlib::git+https://github.com/davisking/dlib.git'
        'qColorimetricSegmenter::git+https://github.com/CloudCompare/qColorimetricSegmenter.git'
        'qJSonRPCPlugin::git+https://github.com/CloudCompare/qJSonRPCPlugin.git'
