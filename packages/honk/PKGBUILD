pkgname=honk
pkgver=0.0.1.beta.56
pkgrel=1
pkgdesc='eBPF transparent proxy engine: dae-style TC datapath with sing-box-style outbounds'
arch=('x86_64')
url='https://github.com/daeuniverse/honk'
license=('GPL-3.0-only')
depends=('glibc' 'gcc-libs')
makedepends=('rust' 'rust-src' 'cmake' 'clang')
options=('!lto' '!debug')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz"
        'honk.service')
sha256sums=('0fc70762ffb7879d2f708e07408b6a8ab26df834d760a075ee681cb76d92ff75'
            '8281eb40b6fdfeebc551d5c9f59bf4ce303722a847a86b8a677e69ab8dff75c1')
sha256sums_x86_64=('4dda77daab6c5f120a468e6d3ede2498f5bd47ece712172cfb7290176d93d015')
# bpf-linker 0.11.0 defaults to the llvm-23 feature; Arch still ships LLVM 22.
_bpflinker=0.10.4
source_x86_64=("bpf-linker-$_bpflinker-x86_64.tar.zst::https://github.com/aya-rs/bpf-linker/releases/download/v$_bpflinker/bpf-linker-x86_64-unknown-linux-musl.tar.zst")

build() {
  export PATH="$srcdir:$PATH"
  cd "$pkgname-$pkgver"

  # The eBPF crate pins the upstream dev-container linker path. Idempotent.
  sed -i 's|/root/.cargo/bin/bpf-linker-wrapper|bpf-linker|' crates/honk-ebpf/.cargo/config.toml

  ( cd crates/honk-ebpf
    env -u RUSTFLAGS -u CARGO_ENCODED_RUSTFLAGS RUSTC_BOOTSTRAP=1 \
      cargo build --release --locked -Zbuild-std=core --target bpfel-unknown-none
    readelf -S target/bpfel-unknown-none/release/honk-ebpf | grep -q '\.BTF' )

  # Upstream ships [profile.release] at opt-level = "s"; override it to 2.
  CARGO_PROFILE_RELEASE_OPT_LEVEL=2 cargo build --release --locked -p honk-core \
      --no-default-features --features ebpf,mimalloc,clash-api
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 target/release/honk-core "$pkgdir/usr/bin/honk-core"
  install -dm750 "${pkgdir}/etc/${pkgname}"
  install -Dm644 "$srcdir/honk.service" "$pkgdir/usr/lib/systemd/system/honk.service"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  (cd doc && find . -type f -exec install -Dm644 "{}" "$pkgdir/usr/share/doc/$pkgname/{}" \;)
}
