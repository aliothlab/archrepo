pkgname=honk
pkgver=0.0.1.beta.84
pkgrel=1
pkgdesc='eBPF transparent proxy engine: dae-style TC datapath with sing-box-style outbounds'
arch=('x86_64')
url='https://github.com/daeuniverse/honk'
license=('GPL-3.0-only')
depends=('glibc' 'libgcc' 'libstdc++')
makedepends=('rust' 'rust-src' 'cmake' 'clang' 'git' 'bpf-linker')
options=('!lto' '!debug')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz"
        'honk.service')
sha256sums=('62759bd93e7e97b91d90ebeb24e9c99b0c239ebe44be8d6140d3049089ec2c13'
            'cda659364fcef260f5e5b3a808d4291b1176c6e6f127dd60e1e1da0e619a1bdc')

prepare() {
  cd "$pkgname-$pkgver"

  # bpf-linker derives BTF from DWARF, so the sub-build keeps its source paths.
  sed -i "s|^rustflags = \[|&\n  \"--remap-path-prefix=$srcdir=/usr/src/debug/$pkgbase\",|" \
    crates/honk-ebpf/.cargo/config.toml

  cargo fetch --locked --target "$(rustc --print host-tuple)"
  ( cd crates/honk-ebpf
    RUSTC_BOOTSTRAP=1 cargo fetch --locked -Zbuild-std=core \
      --target bpfel-unknown-none --target "$(rustc --print host-tuple)" )
}

build() {
  export PATH="$srcdir:$PATH"
  cd "$pkgname-$pkgver"

  ( cd crates/honk-ebpf
    env -u RUSTFLAGS -u CARGO_ENCODED_RUSTFLAGS RUSTC_BOOTSTRAP=1 \
      cargo build --release --frozen -Zbuild-std=core --target bpfel-unknown-none
    readelf -S target/bpfel-unknown-none/release/honk-ebpf | grep -q '\.BTF'
    # honk-core's build.rs only reuses the object when this sidecar matches the pinned channel;
    # otherwise it runs `cargo +<channel>`, which needs rustup.
    sed -n 's/^channel *= *"\(.*\)"/\1/p' rust-toolchain.toml \
      | tr -d '\n' > target/bpfel-unknown-none/release/honk-ebpf.toolchain )

  # Upstream ships [profile.release] at opt-level = "s"; override it to 2.
  CARGO_PROFILE_RELEASE_OPT_LEVEL=2 cargo build --release --frozen -p honk-core \
      --no-default-features --features ebpf,mimalloc,clash-api
}

check() {
  cd "$pkgname-$pkgver"

  # test_geosite_* need a real geosite.dat; test_routing_with_config_dae fails upstream too.
  cargo test --frozen --workspace --no-fail-fast -- \
    --skip test_routing_with_config_dae \
    --skip test_geosite_cn_route \
    --skip test_geosite_route
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 target/release/honk-core "$pkgdir/usr/bin/honk-core"
  install -dm750 "${pkgdir}/etc/${pkgname}"
  install -Dm644 "$srcdir/honk.service" "$pkgdir/usr/lib/systemd/system/honk.service"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  (cd doc && find . -type f -exec install -Dm644 "{}" "$pkgdir/usr/share/doc/$pkgname/{}" \;)
}
