[Unit]
Description=honk eBPF transparent proxy engine
Documentation=https://github.com/daeuniverse/honk
After=network-online.target systemd-sysctl.service
Wants=network-online.target
RequiresMountsFor=/sys/fs/bpf
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=notify
ExecStart=/usr/bin/honk-core --config /etc/honk/config.dae
ExecReload=/usr/bin/kill -HUP $MAINPID

# cache.db + external UI live here; also the CWD so a relative
# experimental.clash_api.external_ui lands in a writable place.
StateDirectory=honk
StateDirectoryMode=0700
WorkingDirectory=/var/lib/honk

# ── Capabilities ──
# CAP_SYS_ADMIN:        unshare(CLONE_NEWNET) + setns + mount tmpfs for daens
# CAP_NET_ADMIN:        rtnetlink, tcx, sk_lookup, bpf() prog load, SO_MARK
# CAP_NET_RAW:          IP_TRANSPARENT / IPV6_TRANSPARENT
# CAP_NET_BIND_SERVICE: TPROXY reply sockets bind the ORIGINAL dst port
#                       (DNS replies are sent from port 53)
# CAP_SYS_ADMIN already satisfies bpf_capable()/perfmon_capable().
NoNewPrivileges=true
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE

# ── Filesystem ──
# /run: the instance lock plus the /run/netns tmpfs mount.
# /sys stays writable under strict (bpffs pinning) — do NOT add
# ProtectKernelTunables, it turns both /sys and /proc/sys read-only and
# the engine writes net.* sysctls directly through /proc/sys.
ProtectSystem=strict
ProtectHome=true
PrivateTmp=disconnected
ReadWritePaths=/run
UMask=0077
PrivateDevices=true

# ── Kernel / system ──
# ProtectControlGroups must stay 'true', never 'private': a private cgroup
# namespace would make the 6 cgroup_sock/sock_addr programs attach to the
# service's own cgroup instead of the host root, silently killing pname
# routing.
ProtectClock=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectHostname=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictNamespaces=net

# ── Address families ──
# AF_UNIX: sd_notify. AF_NETLINK: NETLINK_ROUTE (rtnetlink + link watcher)
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

# ── Syscalls ──
# bpf: lives in @privileged, not @system-service
# mount/umount2: the daens compat mount at /run/netns
SystemCallArchitectures=native
SystemCallFilter=@system-service bpf mount umount2

# ── Resources / restart ──
# TimeoutStopSec: draining a busy gateway can exceed the 90s default, and a
# SIGKILL leaves the dae0 veth, the daens netns and the policy routes behind.
# TasksMax: tokio's blocking pool alone can reach 512 threads.
# No MemoryMax: BPF map memory is charged to this unit's memcg.
Restart=on-failure
RestartSec=5s
TimeoutStopSec=300
LimitNOFILE=1048576
TasksMax=1024
OOMScoreAdjust=-500

[Install]
WantedBy=multi-user.target
